# EVALSURE API — local defaults (DO NOT commit real secrets)
# For Docker Compose, prefer the repo-root .env from `.env.example`.
# For API-only local runs:
#   cp .env.example .env

APP_NAME=EVALSURE
API_PREFIX=/api/v1
DEBUG=false
ENVIRONMENT=development

# Use @localhost when PostgreSQL runs on the host; Compose overrides these to @db.
DATABASE_URL=postgresql+asyncpg://evalsure:evalsure@localhost:5432/evalsure
DATABASE_URL_SYNC=postgresql://evalsure:evalsure@localhost:5432/evalsure

# JWT (web dashboard). Prefer EVALSURE_* names; JWT_* aliases still work.
# Production: provide via environment / secret manager — never commit real secrets.
EVALSURE_JWT_SECRET=dev-only-change-me-now
EVALSURE_JWT_ALGORITHM=HS256
EVALSURE_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Intentional CORS allowlist (comma-separated). Dashboard default:
EVALSURE_CORS_ORIGINS=http://localhost:3000

# LLM-as-a-judge (optional until you use the llm_judge metric).
# NEVER commit real API keys. Keys are never stored in config_snapshot or API responses.
EVALSURE_JUDGE_PROVIDER=openai_compatible
EVALSURE_JUDGE_MODEL=gpt-4o-mini
EVALSURE_JUDGE_API_KEY=
EVALSURE_JUDGE_BASE_URL=https://api.openai.com/v1
EVALSURE_JUDGE_TIMEOUT_SECONDS=60
