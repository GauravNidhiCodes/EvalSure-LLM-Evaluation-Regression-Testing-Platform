# EVALSURE API — Phase 0 local defaults (DO NOT commit real secrets)
# Copy to .env and adjust as needed:
#   cp .env.example .env

APP_NAME=EVALSURE
API_PREFIX=/api/v1
DEBUG=false
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://evalsure:evalsure@localhost:5432/evalsure
DATABASE_URL_SYNC=postgresql://evalsure:evalsure@localhost:5432/evalsure

# Required. Use a long random value outside local demos.
JWT_SECRET=dev-only-change-me-now
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
