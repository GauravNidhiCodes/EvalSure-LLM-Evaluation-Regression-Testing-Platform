# EVALSURE web dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side API base (Docker Compose). Leave unset for local `npm run dev`.
# EVALSURE_API_INTERNAL_URL=http://api:8000

# Optional server-only JWT fallback for CI / automation (never NEXT_PUBLIC_*).
# Prefer signing in via /login (httpOnly cookie session).
EVALSURE_ACCESS_TOKEN=
