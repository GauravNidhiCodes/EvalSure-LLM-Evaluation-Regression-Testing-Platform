# EVALSURE Compose / shared local defaults
# Copy:  cp .env.example .env
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
EVALSURE_JWT_SECRET=dev-only-change-me-now-use-a-long-random-value

# PostgreSQL (Compose `db` service)
POSTGRES_DB=evalsure
POSTGRES_USER=evalsure
POSTGRES_PASSWORD=evalsure

# -----------------------------------------------------------------------------
# Optional — ports & runtime
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000

APP_NAME=EVALSURE
API_PREFIX=/api/v1
DEBUG=false
ENVIRONMENT=development

# Browser → API (host machine). Keep localhost when ports are published.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js server → API inside Compose (service hostname). Override only if needed.
EVALSURE_API_INTERNAL_URL=http://api:8000

EVALSURE_JWT_ALGORITHM=HS256
EVALSURE_ACCESS_TOKEN_EXPIRE_MINUTES=10080
EVALSURE_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional — LLM-as-a-judge (leave empty unless using llm_judge)
# -----------------------------------------------------------------------------
EVALSURE_JUDGE_PROVIDER=openai_compatible
EVALSURE_JUDGE_MODEL=gpt-4o-mini
EVALSURE_JUDGE_API_KEY=
EVALSURE_JUDGE_BASE_URL=https://api.openai.com/v1
EVALSURE_JUDGE_TIMEOUT_SECONDS=60
